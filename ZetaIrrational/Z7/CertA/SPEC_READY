-- per-k exponent (PROOF_ZETA §4), CertA-side counts (Pointwise.lean)
def cp (m p k : ℕ) : ℕ :=
  5 * #{l ∈ Icc (1 : ℤ) (220 * ((m : ℤ) + 1)) | (p : ℤ) ∣ (k : ℤ) + l} +
    5 * #{l ∈ Icc ((nOf m : ℤ) + 1) (460 * ((m : ℤ) + 1)) | (p : ℤ) ∣ l - k}
      -- zero hits without the e-term; W1's c_p(k) (with e-term) is ≥ this, so its e_p(k) is ≤ epk
def Ppj (m p d k : ℕ) : ℕ :=
  #{k' ∈ (Icc ((3 * d * (m + 1) : ℕ) : ℤ) ((nOf m - 3 * d * (m + 1) : ℕ) : ℤ)).erase (k : ℤ) | (p : ℤ) ∣ k' - k}
def Pp (m p k : ℕ) : ℤ := (blocks.map fun b => (b.2 : ℤ) * (Ppj m p b.1 k : ℤ)).sum
def epk (m p k : ℕ) : ℤ :=
  if p ≤ k then (Bk m k : ℤ) + 4 - cp m p k + Pp m p k
  else if 1 ≤ Pp m p k then (Bk m k : ℤ) - 1 - cp m p k + Pp m p k
  else 0
theorem pointwise_le_eStar (m p k : ℕ) (hp : 0 < p) (hpn : p ≤ nOf m) (hk : 1 ≤ Bk m k) :
    (epk m p k : ℚ) - G * ⌊(nOf m : ℚ) / p⌋ ≤ eStar ((nOf m : ℚ) / p)
theorem pointwise_le_eStar_prime (m p k : ℕ) (hp : p.Prime) (hpn : p ≤ nOf m) (hk : 1 ≤ Bk m k) : (same)
  -- Note: no hypothesis 𝒩 < p² is needed for this inequality; E_p = max(0, max_k e_p(k)), and
  -- eStar x ≥ -G⌊x⌋ (eStarInt ≥ 0, `eStarInt_nonneg`), so the max with 0 is covered:
lemma eStarInt_nonneg (x : ℚ) : 0 ≤ eStarInt x                     -- Sound.lean
def eStar (x : ℚ) : ℚ := if 1 ≤ x then (eStarInt x : ℚ) - G * ⌊x⌋ else 0

