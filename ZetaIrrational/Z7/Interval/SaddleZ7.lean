/-
# Certified saddle data (S0), (S1), (S1′) for instance Z7 (PROOF_ZETA §6.3)

Instance Z7 (`r = 11/12`, `q = 240`, phase `3πi`), factor list `facZ7` (`FacZ7.lean`).

* `c0` = a rational point (25 digits) near the Newton root of `Ψ' = 3πi` from the seed
  `0.8921643 + 0.1829121 i` (`ConstZ7.lean`, generated by `scripts/saddle/gen_saddle_Z7.py`),
  `R0 = 10⁻¹²`, `B0 = closedBall c0 R0`;
* `x₀` = **the unique zero of `g = Ψ' - 3πi` in `B0`** (existence and uniqueness:
  `exists_unique_zero_g`, by the contraction `z ↦ z - Y g(z)` of `Interval/Newton.lean`);
  `deriv Ψ x₀ = 3πi`.

Main results:
* `saddle_mem`, `deriv_Ψ_saddle`, `saddle_unique` — (S0);
* `Z7_K_ge : 28 ≤ ‖Ψ''(x₀)‖`, `Z7_d2_mem` (box for `Ψ''(x₀)`);
* `Z7_M_bound : ∀ z ∈ closedBall x₀ ρ, ‖Ψ'''(z)‖ ≤ Mcert` with `ρ = 1/20`, `Mcert ≈ 310.2`;
* `Z7_rho_M : Mcert * ρ ≤ 3 |Ψ''(x₀)| / 2` — (S1) (`Mcert ρ ≈ 15.5 ≤ 42`);
* `Z7_disc_upper`, `Z7_S1'` — (S1′): the Taylor disc lies in `Im z > 0` (`Im x₀ ≈ 0.1829`).

The value `Ω = f(x₀)` and (H4) are in `OmegaZ7.lean`. All numerical checks are `decide +kernel`
(no `native_decide`).

Status: complete (no `sorry`).
-/
import ZetaIrrational.Z7.Interval.FacZ7
import ZetaIrrational.Z7.Interval.ConstZ7
import ZetaIrrational.Interval.Newton

namespace ZetaIrr.Z7.Interval

open Complex Metric ZetaIrr.Interval ZetaIrr.Interval.IV Real

/-! ## Certificate data -/

/-- The rational centre `c0 ≈ 0.8921643008 + 0.1829120718 i`. -/
noncomputable def c0 : ℂ := ⟨(cRe : ℝ), (cIm : ℝ)⟩
def R0 : ℚ := 1 / 10 ^ 12
/-- `Y ≈ 1 / Ψ''(c0)`. -/
noncomputable def Y : ℂ := ⟨(Yre : ℝ), (Yim : ℝ)⟩

/-- Precision parameters: rounding `2^{-80}`, 40 series terms. -/
abbrev pp : ℕ := 80
abbrev nn : ℕ := 40

def P0 : CB := CB.ofQ cRe cIm
def B0box : CB := CB.ofQRad cRe cIm R0
def YB : CB := CB.ofQ Yre Yim
def gP : CB := (dpsiB pp nn facZ7 P0).sub (phIB 3)
def d2B : CB := d2psiB facZ7 B0box
def KB : CB := (CB.ofQ 1 0).sub (YB.mul d2B)

lemma mem_P0 : P0.mem c0 := CB.mem_ofQ cRe cIm

lemma mem_threePiI : (phIB 3).mem (3 * π * I) := by
  have := mem_phIB 3; push_cast at this; exact this

lemma mem_YB : YB.mem Y := CB.mem_ofQ Yre Yim

lemma mem_B0box {z : ℂ} (hz : z ∈ closedBall c0 R0) : B0box.mem z := by
  apply CB.mem_ofQRad
  rw [mem_closedBall, dist_eq_norm] at hz
  exact hz

lemma mem_gP : gP.mem (g c0) := CB.mem_sub (mem_dpsiB pp nn facZ7 mem_P0) (mem_phIB 3)

lemma mem_d2B {z : ℂ} (hz : z ∈ closedBall c0 R0) : d2B.mem (d2psiL facZ7 z) :=
  mem_d2psiB facZ7 (mem_B0box hz)

lemma mem_KB {z : ℂ} (hz : z ∈ closedBall c0 R0) : KB.mem (1 - Y * d2psiL facZ7 z) :=
  CB.mem_sub mem_one (CB.mem_mul mem_YB (mem_d2B hz))

/-! ## Kernel-checked numerical facts -/

lemma chk_K : KB.normLe (1 / 10 ^ 6) = true := by decide +kernel
lemma chk_d2 : d2B.normLe 30 = true := by decide +kernel
lemma chk_K_lo : d2B.normGe 28 = true := by decide +kernel
lemma chk_g : gP.normLe (1 / 10 ^ 16) = true := by decide +kernel
lemma chk_Y : YB.normLe 1 = true := by decide +kernel

lemma im_pos_of_mem_ball {z : ℂ} {r : ℝ} (hz : z ∈ closedBall c0 r) (hr : r < cIm) :
    0 < z.im := by
  rw [mem_closedBall, dist_eq_norm] at hz
  have h := Complex.abs_im_le_norm (z - c0)
  rw [sub_im] at h
  have : c0.im = cIm := rfl
  rw [this] at h
  have := abs_le.1 (h.trans hz)
  linarith [this.1]

lemma R0_nonneg : (0 : ℝ) ≤ (R0 : ℝ) := by norm_num [R0]

lemma c0_mem : c0 ∈ closedBall c0 (R0 : ℝ) := mem_closedBall_self R0_nonneg

lemma R0_lt : (R0 : ℝ) < cIm := by
  have : R0 < cIm := by norm_num [R0, cIm]
  exact_mod_cast this

lemma im_ne_of_ball {z : ℂ} (hz : z ∈ closedBall c0 R0) : z.im ≠ 0 :=
  (im_pos_of_mem_ball hz R0_lt).ne'

/-! ## (S0): existence and uniqueness of the saddle -/

lemma Y_ne : Y ≠ 0 := by
  intro h
  have : Y.re = 0 := by rw [h]; rfl
  simp [Y, Yre] at this

lemma norm_g_c0 : ‖g c0‖ ≤ ((1 / 10 ^ 16 : ℚ) : ℝ) := CB.norm_le_of_normLe mem_gP chk_g

lemma norm_Yg : ‖Y * g c0‖ ≤ ((1 / 10 ^ 16 : ℚ) : ℝ) := by
  have hY : ‖Y‖ ≤ ((1 : ℚ) : ℝ) := CB.norm_le_of_normLe mem_YB chk_Y
  rw [norm_mul]
  have h0 : (0 : ℝ) ≤ ‖g c0‖ := norm_nonneg _
  push_cast at hY
  calc ‖Y‖ * ‖g c0‖ ≤ 1 * ‖g c0‖ := mul_le_mul_of_nonneg_right hY h0
    _ ≤ _ := by rw [one_mul]; exact norm_g_c0

theorem exists_unique_zero_g : ∃! z, z ∈ closedBall c0 R0 ∧ g z = 0 := by
  have hR : (0 : ℝ) ≤ R0 := by norm_num [R0]
  refine exists_unique_zero_of_contraction (g' := d2psiL facZ7) (κ := ((1 / 10 ^ 6 : ℚ) : ℝ))
    (ε := ((1 / 10 ^ 16 : ℚ) : ℝ)) Y_ne hR (fun z hz => Z7_hasDerivAt_g (im_ne_of_ball hz))
    (fun z hz => CB.norm_le_of_normLe (mem_KB hz) chk_K) (by norm_num) norm_Yg ?_
  norm_num [R0]

/-- **The saddle point** `x₀`: the unique zero of `Ψ' - 3πi` in `closedBall c0 R0`. -/
noncomputable def x₀ : ℂ := Classical.choose exists_unique_zero_g

lemma x₀_spec : x₀ ∈ closedBall c0 R0 ∧ g x₀ = 0 := (Classical.choose_spec exists_unique_zero_g).1

theorem saddle_mem : x₀ ∈ closedBall c0 R0 := x₀_spec.1

lemma x₀_im_pos : 0 < x₀.im := im_pos_of_mem_ball saddle_mem R0_lt

theorem deriv_Ψ_saddle : deriv Ψ x₀ = 3 * π * I := by
  rw [deriv_Ψ x₀_im_pos.ne']
  have := x₀_spec.2
  rw [g_apply] at this
  exact sub_eq_zero.1 this

theorem saddle_unique {z : ℂ} (hz : z ∈ closedBall c0 R0) (hd : deriv Ψ z = 3 * π * I) :
    z = x₀ := by
  have hg : g z = 0 := by
    rw [g_apply, ← deriv_Ψ (im_ne_of_ball hz), hd, sub_self]
  exact (exists_unique_zero_g.unique ⟨hz, hg⟩ x₀_spec)

/-- `‖g‖ ≤ 1/10^16 + 30 R0` on the ball. -/
lemma norm_g_le {z : ℂ} (hz : z ∈ closedBall c0 R0) :
    ‖g z‖ ≤ ((1 / 10 ^ 16 + 30 * R0 : ℚ) : ℝ) := by
  have hmv := (convex_closedBall c0 (R0 : ℝ)).norm_image_sub_le_of_norm_hasDerivWithin_le
    (f := g) (f' := d2psiL facZ7) (C := 30)
    (fun w hw => (Z7_hasDerivAt_g (im_ne_of_ball hw)).hasDerivWithinAt)
    (fun w hw => by exact_mod_cast CB.norm_le_of_normLe (mem_d2B hw) chk_d2)
    c0_mem hz
  have h0 := norm_g_c0
  have hzc : ‖z - c0‖ ≤ R0 := by rw [← dist_eq_norm]; exact hz
  calc ‖g z‖ = ‖g c0 + (g z - g c0)‖ := by ring_nf
    _ ≤ ‖g c0‖ + ‖g z - g c0‖ := norm_add_le _ _
    _ ≤ ((1 / 10 ^ 16 : ℚ) : ℝ) + 30 * R0 := by nlinarith
    _ = ((1 / 10 ^ 16 + 30 * R0 : ℚ) : ℝ) := by push_cast; ring

/-! ## (S1), (S1′): Taylor disc data -/

/-- Box enclosure of `Ψ''(x₀)`. -/
lemma Z7_d2_mem : d2B.mem (d2psiL facZ7 x₀) := mem_d2B saddle_mem

/-- **(S1)** `K = |Ψ''(x₀)| ≥ 28`. -/
theorem Z7_K_ge : (28 : ℝ) ≤ ‖d2psiL facZ7 x₀‖ := by
  have := CB.le_norm_of_normGe Z7_d2_mem chk_K_lo
  push_cast at this; exact this

/-- Taylor-disc radius `ρ = 1/20`. -/
def ρ : ℚ := 1 / 20

/-- Lower bounds `m_i` for `|α_i|` on `closedBall x₀ ρ`. -/
def facM : List (Fac × ℚ) := List.zip facZ7 (facMs.map fun k : ℕ => (k : ℚ) / 10 ^ 6)

lemma facM_fst : facM.map Prod.fst = facZ7 := by decide +kernel

/-- The certified bound for `sup |Ψ'''|` on the Taylor disc. -/
def Mcert : ℚ := d3bnd facM

lemma chk_M : d3chk P0 (ρ + R0) facM = true := by decide +kernel

lemma chk_Mρ : Mcert * ρ ≤ 3 * 28 / 2 := by decide +kernel

lemma chk_Mval : Mcert ≤ 311 := by decide +kernel

lemma norm_sub_c0_le {z : ℂ} (hz : z ∈ closedBall x₀ (ρ : ℝ)) :
    ‖z - c0‖ ≤ ((ρ + R0 : ℚ) : ℝ) := by
  rw [mem_closedBall, dist_eq_norm] at hz
  have h0 : ‖x₀ - c0‖ ≤ R0 := by rw [← dist_eq_norm]; exact saddle_mem
  calc ‖z - c0‖ = ‖(z - x₀) + (x₀ - c0)‖ := by ring_nf
    _ ≤ ‖z - x₀‖ + ‖x₀ - c0‖ := norm_add_le _ _
    _ ≤ ρ + R0 := add_le_add hz h0
    _ = ((ρ + R0 : ℚ) : ℝ) := by push_cast; ring

/-- **(S1)** `|Ψ'''| ≤ Mcert` on `closedBall x₀ ρ`. -/
theorem Z7_M_bound {z : ℂ} (hz : z ∈ closedBall x₀ (ρ : ℝ)) :
    ‖d3psiL facZ7 z‖ ≤ (Mcert : ℝ) := by
  have := norm_d3psiL_le facM mem_P0 (norm_sub_c0_le hz) chk_M
  rw [facM_fst] at this; exact this

/-- **(S1)** `M ρ ≤ 3K/2` with `K ≥ 28`. -/
theorem Z7_rho_M : (Mcert : ℝ) * ρ ≤ 3 * ‖d2psiL facZ7 x₀‖ / 2 := by
  have h : ((Mcert * ρ : ℚ) : ℝ) ≤ ((3 * 28 / 2 : ℚ) : ℝ) := by exact_mod_cast chk_Mρ
  push_cast at h
  linarith [Z7_K_ge]

/-- **(S1′)** the Taylor disc lies in the upper half plane. -/
theorem Z7_disc_upper {z : ℂ} (hz : z ∈ closedBall x₀ (ρ : ℝ)) : 0 < z.im := by
  have h := norm_sub_c0_le hz
  have hz' : z ∈ closedBall c0 ((ρ + R0 : ℚ) : ℝ) := by
    rw [mem_closedBall, dist_eq_norm]; exact h
  refine im_pos_of_mem_ball hz' ?_
  have : (ρ + R0 : ℚ) < cIm := by norm_num [ρ, R0, cIm]
  exact_mod_cast this

theorem Z7_S1' : 0 < x₀.im - ρ := by
  have h := Z7_disc_upper (z := x₀ - (ρ : ℂ) * I) (by
    rw [mem_closedBall, dist_eq_norm]
    have : x₀ - (ρ : ℂ) * I - x₀ = -((ρ : ℝ) : ℂ) * I := by push_cast; ring
    rw [this, norm_mul, norm_neg, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (by norm_num [ρ])])
  simpa using h

end ZetaIrr.Z7.Interval
